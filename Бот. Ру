import os
import sqlite3
import hashlib
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import Application, CommandHandler, MessageHandler, CallbackQueryHandler, ContextTypes, filters

TOKEN = os.getenv("BOT_TOKEN") or os.getenv("MONNEY_TOKEN")
DATA_DIR = os.getenv("DATA_DIR", "data")
os.makedirs(DATA_DIR, exist_ok=True)
DB = os.path.join(DATA_DIR, "monney.db")
ADMIN_ID = 8976178026

if not TOKEN:
    raise SystemExit("BOT_TOKEN или MONNEY_TOKEN не задан.")


def db():
    con = sqlite3.connect(DB)
    con.row_factory = sqlite3.Row
    return con


def ensure_column(con, table, column, definition):
    cols = [r["name"] for r in con.execute(f"PRAGMA table_info({table})").fetchall()]
    if column not in cols:
        con.execute(f"ALTER TABLE {table} ADD COLUMN {column} {definition}")


def init_db():
    con = db()
    con.execute("""
        CREATE TABLE IF NOT EXISTS files (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            folder_id INTEGER,
            kind TEXT NOT NULL,
            file_id TEXT,
            text TEXT,
            hidden INTEGER DEFAULT 0,
            deleted INTEGER DEFAULT 0,
            created_at TEXT DEFAULT CURRENT_TIMESTAMP
        )
    """)
    con.execute("""
        CREATE TABLE IF NOT EXISTS folders (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            name TEXT NOT NULL,
            created_at TEXT DEFAULT CURRENT_TIMESTAMP
        )
    """)
    con.execute("""
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            username TEXT,
            first_name TEXT,
            blocked INTEGER DEFAULT 0,
            pin_hash TEXT
        )
    """)
    ensure_column(con, "users", "username", "TEXT")
    ensure_column(con, "users", "first_name", "TEXT")
    ensure_column(con, "users", "blocked", "INTEGER DEFAULT 0")
    ensure_column(con, "users", "pin_hash", "TEXT")
    ensure_column(con, "files", "folder_id", "INTEGER")
    ensure_column(con, "files", "hidden", "INTEGER DEFAULT 0")
    ensure_column(con, "files", "deleted", "INTEGER DEFAULT 0")
    con.commit()
    con.close()


def register_user(user):
    con = db()
    con.execute("""
        INSERT INTO users(user_id, username, first_name)
        VALUES(?,?,?)
        ON CONFLICT(user_id) DO UPDATE SET
            username=excluded.username,
            first_name=excluded.first_name
    """, (user.id, user.username, user.first_name))
    con.commit()
    con.close()


def hash_pin(pin):
    return hashlib.sha256(pin.encode("utf-8")).hexdigest()


def has_pin(uid):
    con = db()
    row = con.execute("SELECT pin_hash FROM users WHERE user_id=?", (uid,)).fetchone()
    con.close()
    return bool(row and row["pin_hash"])


def pin_ok(uid, pin):
    con = db()
    row = con.execute("SELECT pin_hash FROM users WHERE user_id=?", (uid,)).fetchone()
    con.close()
    return bool(row and row["pin_hash"] == hash_pin(pin))


def set_pin(uid, pin):
    con = db()
    con.execute("UPDATE users SET pin_hash=? WHERE user_id=?", (hash_pin(pin), uid))
    con.commit()
    con.close()


def remove_pin(uid):
    con = db()
    con.execute("UPDATE users SET pin_hash=NULL WHERE user_id=?", (uid,))
    con.commit()
    con.close()


def menu(uid):
    rows = [
        [InlineKeyboardButton("➕ Добавить файл", callback_data="add"),
         InlineKeyboardButton("🗂 Галерея", callback_data="gallery")],
        [InlineKeyboardButton("📁 Папки", callback_data="folders"),
         InlineKeyboardButton("📝 Тексты и ссылки", callback_data="texts")],
        [InlineKeyboardButton("🙈 Скрытые файлы", callback_data="hidden"),
         InlineKeyboardButton("🗑 Корзина", callback_data="trash")],
        [InlineKeyboardButton("⚙️ Настройки", callback_data="settings")]
    ]
    if uid == ADMIN_ID:
        rows.append([InlineKeyboardButton("👑 Админ-панель", callback_data="admin")])
    return InlineKeyboardMarkup(rows)


def home_button(uid):
    return InlineKeyboardMarkup([[InlineKeyboardButton("🏠 Главное меню", callback_data="home")]])


def pin_keyboard():
    return InlineKeyboardMarkup([[InlineKeyboardButton("🏠 Главное меню", callback_data="home")]])


async def send_home(chat_id, context):
    await context.bot.send_message(chat_id, "💰 MONNEY\n\nТвоё личное хранилище.\nВыбери действие:", reply_markup=menu(chat_id))


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    register_user(update.effective_user)
    await update.message.reply_text(
        "💰 MONNEY\n\nТвоё личное хранилище.\nФото, видео, файлы, тексты и ссылки сохраняются здесь.",
        reply_markup=menu(update.effective_user.id)
    )


async def remove_old_button_message(q):
    try:
        await q.message.delete()
    except Exception:
        try:
            await q.edit_message_reply_markup(reply_markup=None)
        except Exception:
            pass


def kind_label(kind):
    return {
        "photo": "📸 Фото",
        "video": "🎥 Видео",
        "document": "📄 Файл",
        "audio": "🎵 Аудио",
        "voice": "🎙 Голосовое",
        "animation": "🎞 GIF",
        "text": "📝 Текст",
    }.get(kind, "📦 Файл")


async def send_stored_file(chat_id, context, row):
    kind = row["kind"]
    fid = row["file_id"]
    if kind == "photo":
        await context.bot.send_photo(chat_id, fid)
    elif kind == "video":
        await context.bot.send_video(chat_id, fid)
    elif kind == "document":
        await context.bot.send_document(chat_id, fid)
    elif kind == "audio":
        await context.bot.send_audio(chat_id, fid)
    elif kind == "voice":
        await context.bot.send_voice(chat_id, fid)
    elif kind == "animation":
        await context.bot.send_animation(chat_id, fid)
    elif kind == "text":
        await context.bot.send_message(chat_id, f"📝 {row['text']}")


async def callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    q = update.callback_query
    await q.answer()
    uid = q.from_user.id
    register_user(q.from_user)
    data = q.data

    if data == "home":
        context.user_data.pop("pin_action", None)
        await remove_old_button_message(q)
        await send_home(q.message.chat_id, context)
        return

    if data == "add":
        await remove_old_button_message(q)
        await context.bot.send_message(
            q.message.chat_id,
            "➕ Отправь мне фото, видео, документ, аудио, GIF или текст.\n\nЯ сохраню его автоматически.",
            reply_markup=home_button(uid)
        )
        return

    if data == "gallery":
        await remove_old_button_message(q)
        con = db()
        rows = con.execute(
            "SELECT * FROM files WHERE user_id=? AND deleted=0 AND hidden=0 ORDER BY id DESC",
            (uid,)
        ).fetchall()
        con.close()
        if not rows:
            await context.bot.send_message(q.message.chat_id, "🗂 Галерея пока пустая.", reply_markup=home_button(uid))
            return
        await context.bot.send_message(q.message.chat_id, f"🗂 Найдено файлов: {len(rows)}")
        for row in rows[:50]:
            await send_stored_file(q.message.chat_id, context, row)
        await context.bot.send_message(q.message.chat_id, "Готово.", reply_markup=home_button(uid))
        return

    if data == "texts":
        await remove_old_button_message(q)
        con = db()
        rows = con.execute(
            "SELECT * FROM files WHERE user_id=? AND kind='text' AND deleted=0 AND hidden=0 ORDER BY id DESC",
            (uid,)
        ).fetchall()
        con.close()
        if not rows:
            await context.bot.send_message(q.message.chat_id, "📝 Тексты и ссылки пока пустые.", reply_markup=home_button(uid))
            return
        for row in rows[:100]:
            await context.bot.send_message(q.message.chat_id, f"📝 #{row['id']}\n{row['text']}")
        await context.bot.send_message(q.message.chat_id, "Готово.", reply_markup=home_button(uid))
        return

    if data == "hidden":
        await remove_old_button_message(q)
        if not has_pin(uid):
            await context.bot.send_message(
                q.message.chat_id,
                "🔒 Скрытые файлы защищаются PIN-кодом.\n\nСначала задай PIN в Настройках.",
                reply_markup=home_button(uid)
            )
            return
        context.user_data["pin_action"] = "unlock_hidden"
        await context.bot.send_message(q.message.chat_id, "🔐 Введи PIN-код:", reply_markup=pin_keyboard())
        return

    if data == "folders":
        await remove_old_button_message(q)
        con = db()
        rows = con.execute("SELECT * FROM folders WHERE user_id=? ORDER BY id DESC", (uid,)).fetchall()
        con.close()
        buttons = [[InlineKeyboardButton("➕ Создать папку", callback_data="folder_new")]]
        for row in rows:
            buttons.append([InlineKeyboardButton(f"📁 {row['name']}", callback_data=f"folder:{row['id']}")])
        buttons.append([InlineKeyboardButton("🏠 Главное меню", callback_data="home")])
        await context.bot.send_message(q.message.chat_id, "📁 Твои папки:", reply_markup=InlineKeyboardMarkup(buttons))
        return

    if data == "folder_new":
        await remove_old_button_message(q)
        context.user_data["waiting_folder"] = True
        await context.bot.send_message(q.message.chat_id, "📁 Напиши название новой папки:", reply_markup=home_button(uid))
        return

    if data.startswith("folder:"):
        await remove_old_button_message(q)
        folder_id = int(data.split(":", 1)[1])
        con = db()
        folder = con.execute("SELECT * FROM folders WHERE id=? AND user_id=?", (folder_id, uid)).fetchone()
        rows = con.execute("SELECT * FROM files WHERE folder_id=? AND user_id=? AND deleted=0 AND hidden=0 ORDER BY id DESC", (folder_id, uid)).fetchall()
        con.close()
        if not folder:
            await context.bot.send_message(q.message.chat_id, "Папка не найдена.", reply_markup=home_button(uid))
            return
        await context.bot.send_message(q.message.chat_id, f"📁 {folder['name']}\nФайлов: {len(rows)}")
        for row in rows:
            await send_stored_file(q.message.chat_id, context, row)
        await context.bot.send_message(q.message.chat_id, "Готово.", reply_markup=home_button(uid))
        return

    if data == "folder_add":
        context.user_data["waiting_folder_for_file"] = True
        await q.message.reply_text("📁 Введи ID папки, куда сохранить следующий файл.", reply_markup=home_button(uid))
        return

    if data == "trash":
        await remove_old_button_message(q)
        con = db()
        rows = con.execute("SELECT * FROM files WHERE user_id=? AND deleted=1 ORDER BY id DESC", (uid,)).fetchall()
        con.close()
        if not rows:
            await context.bot.send_message(q.message.chat_id, "🗑 Корзина пустая.", reply_markup=home_button(uid))
            return
        buttons = [[InlineKeyboardButton(f"♻️ Восстановить #{row['id']}", callback_data=f"restore:{row['id']}")] for row in rows[:50]]
        buttons.append([InlineKeyboardButton("🏠 Главное меню", callback_data="home")])
        await context.bot.send_message(q.message.chat_id, "🗑 Корзина:", reply_markup=InlineKeyboardMarkup(buttons))
        return

    if data.startswith("restore:"):
        await remove_old_button_message(q)
        fid = int(data.split(":", 1)[1])
        con = db()
        con.execute("UPDATE files SET deleted=0 WHERE id=? AND user_id=?", (fid, uid))
        con.commit()
        con.close()
        await context.bot.send_message(q.message.chat_id, f"♻️ Файл #{fid} восстановлен.", reply_markup=menu(uid))
        return

    if data == "settings":
        await remove_old_button_message(q)
        pin_status = "✅ установлен" if has_pin(uid) else "❌ не установлен"
        buttons = [
            [InlineKeyboardButton("🔐 Установить / изменить PIN", callback_data="pin_set")],
            [InlineKeyboardButton("🗑 Удалить PIN", callback_data="pin_remove")],
            [InlineKeyboardButton("🏠 Главное меню", callback_data="home")]
        ]
        await context.bot.send_message(
            q.message.chat_id,
            f"⚙️ Настройки\n\n🔐 PIN: {pin_status}\n\nPIN нужен для доступа к скрытым файлам.",
            reply_markup=InlineKeyboardMarkup(buttons)
        )
        return

    if data == "pin_set":
        await remove_old_button_message(q)
        context.user_data["pin_action"] = "set_pin"
        await context.bot.send_message(q.message.chat_id, "🔐 Введи новый PIN-код из 4–8 цифр:", reply_markup=home_button(uid))
        return

    if data == "pin_remove":
        await remove_old_button_message(q)
        if not has_pin(uid):
            await context.bot.send_message(q.message.chat_id, "PIN ещё не установлен.", reply_markup=home_button(uid))
            return
        context.user_data["pin_action"] = "remove_pin"
        await context.bot.send_message(q.message.chat_id, "🔐 Введи текущий PIN-код:", reply_markup=home_button(uid))
        return

    if data == "admin":
        if uid != ADMIN_ID:
            return
        await remove_old_button_message(q)
        con = db()
        users = con.execute("SELECT * FROM users ORDER BY user_id").fetchall()
        total = con.execute("SELECT COUNT(*) AS n FROM files").fetchone()["n"]
        con.close()
        buttons = []
        for u in users[:50]:
            status = "🚫" if u["blocked"] else "🟢"
            name = u["username"] or u["first_name"] or str(u["user_id"])
            buttons.append([InlineKeyboardButton(f"{status} {name}", callback_data=f"adminuser:{u['user_id']}")])
        buttons.append([InlineKeyboardButton("🏠 Главное меню", callback_data="home")])
        await context.bot.send_message(q.message.chat_id, f"👑 АДМИН-ПАНЕЛЬ\n\nПользователей: {len(users)}\nФайлов: {total}", reply_markup=InlineKeyboardMarkup(buttons))
        return

    if data.startswith("adminuser:"):
        if uid != ADMIN_ID:
            return
        await remove_old_button_message(q)
        target = int(data.split(":", 1)[1])
        con = db()
        u = con.execute("SELECT * FROM users WHERE user_id=?", (target,)).fetchone()
        files = con.execute("SELECT * FROM files WHERE user_id=?", (target,)).fetchall()
        folders = con.execute("SELECT * FROM folders WHERE user_id=?", (target,)).fetchall()
        con.close()
        if not u:
            await context.bot.send_message(q.message.chat_id, "Пользователь не найден.", reply_markup=home_button(uid))
            return
        buttons = [
            [InlineKeyboardButton("🚫 Заблокировать" if not u["blocked"] else "✅ Разблокировать", callback_data=f"toggleblock:{target}")],
            [InlineKeyboardButton("📂 Показать файлы", callback_data=f"adminfiles:{target}")],
            [InlineKeyboardButton("📁 Показать папки", callback_data=f"adminfolders:{target}")],
            [InlineKeyboardButton("👑 Админ-панель", callback_data="admin")]
        ]
        await context.bot.send_message(q.message.chat_id, f"👤 ID: {target}\nUsername: @{u['username'] or 'нет'}\nФайлов: {len(files)}\nПапок: {len(folders)}\nСтатус: {'🚫 заблокирован' if u['blocked'] else '🟢 активен'}", reply_markup=InlineKeyboardMarkup(buttons))
        return

    if data.startswith("toggleblock:"):
        if uid != ADMIN_ID:
            return
        await remove_old_button_message(q)
        target = int(data.split(":", 1)[1])
        if target == ADMIN_ID:
            await context.bot.send_message(q.message.chat_id, "Себя блокировать нельзя.", reply_markup=home_button(uid))
            return
        con = db()
        row = con.execute("SELECT blocked FROM users WHERE user_id=?", (target,)).fetchone()
        new_value = 0 if row and row["blocked"] else 1
        con.execute("UPDATE users SET blocked=? WHERE user_id=?", (new_value, target))
        con.commit()
        con.close()
        await context.bot.send_message(q.message.chat_id, "🚫 Пользователь заблокирован." if new_value else "✅ Пользователь разблокирован.", reply_markup=menu(uid))
        return

    if data.startswith("adminfiles:"):
        if uid != ADMIN_ID:
            return
        await remove_old_button_message(q)
        target = int(data.split(":", 1)[1])
        con = db()
        rows = con.execute("SELECT * FROM files WHERE user_id=? ORDER BY id DESC", (target,)).fetchall()
        con.close()
        await context.bot.send_message(q.message.chat_id, f"📂 Файлы пользователя {target}: {len(rows)}")
        for row in rows[:50]:
            mark = "🗑" if row["deleted"] else ("🙈" if row["hidden"] else "📄")
            if row["kind"] == "text":
                await context.bot.send_message(q.message.chat_id, f"{mark} #{row['id']}\n{row['text']}")
            else:
                await send_stored_file(q.message.chat_id, context, row)
        await send_home(q.message.chat_id, context)
        return

    if data.startswith("adminfolders:"):
        if uid != ADMIN_ID:
            return
        await remove_old_button_message(q)
        target = int(data.split(":", 1)[1])
        con = db()
        rows = con.execute("SELECT * FROM folders WHERE user_id=? ORDER BY id DESC", (target,)).fetchall()
        con.close()
        await context.bot.send_message(q.message.chat_id, "📁 Папки:\n" + "\n".join(f"#{r['id']} — {r['name']}" for r in rows) if rows else "📁 Папок нет.")
        await send_home(q.message.chat_id, context)
        return


async def save_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = update.effective_user.id
    register_user(update.effective_user)
    msg = update.message

    con = db()
    user_row = con.execute("SELECT blocked FROM users WHERE user_id=?", (uid,)).fetchone()
    con.close()
    if user_row and user_row["blocked"] and uid != ADMIN_ID:
        return

    # Ожидание создания папки
    if context.user_data.get("waiting_folder") and msg.text:
        name = msg.text.strip()
        if name:
            con = db()
            con.execute("INSERT INTO folders(user_id,name) VALUES(?,?)", (uid, name))
            con.commit()
            con.close()
            context.user_data["waiting_folder"] = False
            await msg.reply_text(f"📁 Папка «{name}» создана.", reply_markup=menu(uid))
        return

    # PIN-сценарии
    pin_action = context.user_data.get("pin_action")
    if pin_action and msg.text:
        pin = msg.text.strip()
        if not pin.isdigit() or not (4 <= len(pin) <= 8):
            await msg.reply_text("❌ PIN должен содержать от 4 до 8 цифр.")
            return

        if pin_action == "set_pin":
            set_pin(uid, pin)
            context.user_data.pop("pin_action", None)
            await msg.reply_text("✅ PIN установлен. Скрытые файлы теперь защищены.", reply_markup=menu(uid))
            return

        if pin_action == "remove_pin":
            if pin_ok(uid, pin):
                remove_pin(uid)
                context.user_data.pop("pin_action", None)
                await msg.reply_text("🗑 PIN удалён.", reply_markup=menu(uid))
            else:
                await msg.reply_text("❌ Неверный PIN. Попробуй ещё раз.")
            return

        if pin_action == "unlock_hidden":
            if not pin_ok(uid, pin):
                await msg.reply_text("❌ Неверный PIN.")
                return
            context.user_data.pop("pin_action", None)
            con = db()
            rows = con.execute("SELECT * FROM files WHERE user_id=? AND hidden=1 AND deleted=0 ORDER BY id DESC", (uid,)).fetchall()
            con.close()
            if not rows:
                await msg.reply_text("🙈 Скрытых файлов пока нет.", reply_markup=menu(uid))
                return
            await msg.reply_text(f"🔐 Доступ разрешён. Скрытых файлов: {len(rows)}")
            for row in rows[:50]:
                await send_stored_file(msg.chat_id, context, row)
            await msg.reply_text("Готово.", reply_markup=menu(uid))
            return

    # Обычное сохранение. Поддерживаем не только фото/видео, но и документы.
    kind = None
    file_id = None
    text = None

    if msg.photo:
        kind, file_id = "photo", msg.photo[-1].file_id
    elif msg.video:
        kind, file_id = "video", msg.video.file_id
    elif msg.document:
        kind, file_id = "document", msg.document.file_id
    elif msg.audio:
        kind, file_id = "audio", msg.audio.file_id
    elif msg.voice:
        kind, file_id = "voice", msg.voice.file_id
    elif msg.animation:
        kind, file_id = "animation", msg.animation.file_id
    elif msg.text and not msg.text.startswith("/"):
        kind, text = "text", msg.text
    else:
        return

    con = db()
    cur = con.execute("INSERT INTO files(user_id,kind,file_id,text) VALUES(?,?,?,?)", (uid, kind, file_id, text))
    item_id = cur.lastrowid
    con.commit()
    con.close()

    await msg.reply_text(f"✅ Сохранено — #{item_id}\n{kind_label(kind)}", reply_markup=menu(uid))


async def error_handler(update, context):
    print("ERROR:", context.error)


def main():
    init_db()
    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(callback))
    app.add_handler(MessageHandler(
        filters.PHOTO | filters.VIDEO | filters.Document.ALL | filters.AUDIO | filters.VOICE | filters.ANIMATION | (filters.TEXT & ~filters.COMMAND),
        save_message
    ))
    app.add_error_handler(error_handler)
    print("MONNEY v4 запущен.")
    app.run_polling()


if __name__ == "__main__":
    main()
